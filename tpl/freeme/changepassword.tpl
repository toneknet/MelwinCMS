<form method="post" name="thelogin" action="?action=change" class="freeme-auth-card freeme-change-password">
  <h2>Du måste ändra ditt lösenord för att fortsätta</h2>
  <label for="password">Nytt lösenord</label>
  <input id="password" type="password" name="password" autocomplete="new-password" required>
  <label for="password2">Bekräfta lösenordet</label>
  <input id="password2" type="password" name="password2" autocomplete="new-password" required>
  <button type="submit" class="button-primary">Ändra lösenord</button>
</form>
